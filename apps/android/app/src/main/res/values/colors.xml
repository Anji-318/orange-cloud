<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="oc_orange">#FFF48120</color>
    <!-- App 图标自适应背景：对齐 iOS AppIcon 的纯白底（三朵橙云前景自带浅卡片+阴影） -->
    <color name="oc_icon_bg">#FFFFFFFF</color>
    <!-- 启动窗背景：与晨昏天景顶色衔接，避免 Compose 接管前的白闪。
         深色值必须与 DarkColors.surface 对齐：App 内强制深色而系统仍是浅色时，
         values-night 不生效，窗口底色由代码按生效主题切换，这里是它的兜底值。 -->
    <color name="oc_window_light">#FFF5F2ED</color>
    <color name="oc_window_dark">#FF16120F</color>
</resources>
